        <mxCell id="msg5" value="5. Query Kredensial" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#0288d1;strokeWidth=1.5;fontSize=10;fontFamily=Times New Roman;fontColor=#0d47a1;exitX=1;exitY=0.36;entryX=0;entryY=0.36;" edge="1" parent="1" source="act_control" target="act_entity">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="msg6" value="6. Return User Data" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#0288d1;strokeWidth=1.5;fontSize=10;fontFamily=Times New Roman;fontColor=#0d47a1;exitX=0;exitY=0.44;entryX=1;entryY=0.44;" edge="1" parent="1" source="act_entity" target="act_control">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="msg7" value="7. Validasi Kredensial &amp;amp; Role" style="html=1;align=left;spacingLeft=2;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;strokeColor=#0288d1;strokeWidth=1.5;fontSize=10;fontFamily=Times New Roman;fontColor=#0d47a1;" edge="1" parent="lifeline_control" target="act_control_sub">
