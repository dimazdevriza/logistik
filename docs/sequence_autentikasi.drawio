<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="sequence_auth" name="Autentikasi">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Sequence Diagram: Autentikasi dan Pengalihan Hak Akses Berdasarkan Role&lt;/b&gt;" style="text;html=1;fontSize=13;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontColor=#01579b;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="15" width="650" height="30" as="geometry"/>
        </mxCell>
        
        <!-- Lifeline: User -->
        <mxCell id="lifeline_user" value="Pengguna&lt;br&gt;(Admin/Logistik)" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=60;verticalAlign=bottom;labelBackgroundColor=none;fillColor=#e1f5fe;strokeColor=#039be5;strokeWidth=1.5;fontFamily=Times New Roman;fontColor=#01579b;fontSize=10;fontStyle=1;" vertex="1" parent="1">
