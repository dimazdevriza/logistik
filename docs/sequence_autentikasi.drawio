          <mxGeometry x="45" y="60" width="10" height="330" as="geometry"/>
        </mxCell>
        
        <!-- Messages -->
        <mxCell id="msg1" value="1. Mengakses Halaman Login" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#0288d1;strokeWidth=1.5;fontSize=10;fontFamily=Times New Roman;fontColor=#0d47a1;exitX=1;exitY=0.05;entryX=0;entryY=0.05;" edge="1" parent="1" source="act_user" target="act_boundary">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="msg2" value="2. Tampilkan Halaman Login" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#0288d1;strokeWidth=1.5;fontSize=10;fontFamily=Times New Roman;fontColor=#0d47a1;exitX=0;exitY=0.12;entryX=1;entryY=0.12;" edge="1" parent="1" source="act_boundary" target="act_user">
          <mxGeometry relative="1" as="geometry"/>
