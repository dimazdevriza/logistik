        </mxCell>
        

        
        <mxCell id="msg8" value="8. Redirect ke Dashboard" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#0288d1;strokeWidth=1.5;fontSize=10;fontFamily=Times New Roman;fontColor=#0d47a1;exitX=0;exitY=0.68;entryX=1;entryY=0.68;" edge="1" parent="1" source="act_control" target="act_boundary">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <mxCell id="msg9" value="9. Render Dashboard sesuai Role" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#0288d1;strokeWidth=1.5;fontSize=10;fontFamily=Times New Roman;fontColor=#0d47a1;exitX=0;exitY=0.76;entryX=1;entryY=0.76;" edge="1" parent="1" source="act_boundary" target="act_user">
