        <!-- Lifeline: Component (Auth Livewire) -->
        <mxCell id="lifeline_control" value="Component:&lt;br&gt;AuthLivewire" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#e1f5fe;strokeColor=#039be5;strokeWidth=1.5;fontFamily=Times New Roman;fontColor=#01579b;fontSize=10;fontStyle=1;" vertex="1" parent="1">
