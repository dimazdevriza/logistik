        </mxCell>
        <mxCell id="act_user" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#ffffff;strokeColor=#039be5;strokeWidth=1;" vertex="1" parent="lifeline_user">
          <mxGeometry x="10" y="60" width="10" height="330" as="geometry"/>
        </mxCell>
        
        <!-- Lifeline: View (LoginForm) -->
        <mxCell id="lifeline_boundary" value="View:&lt;br&gt;LoginForm" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#e1f5fe;strokeColor=#039be5;strokeWidth=1.5;fontFamily=Times New Roman;fontColor=#01579b;fontSize=10;fontStyle=1;" vertex="1" parent="1">
